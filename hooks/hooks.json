{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/juanjuan-team/scripts/hook-enforce.sh pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/juanjuan-team/scripts/hook-enforce.sh subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/juanjuan-team/scripts/heartbeat-check.sh $CLAUDE_PROJECT_DIR 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
