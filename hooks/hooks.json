{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_SKILL_DIR:-~/.claude/skills/juanjuan-team}/scripts/hook-enforce.sh pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_SKILL_DIR:-~/.claude/skills/juanjuan-team}/scripts/hook-enforce.sh subagent-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
